# Lucky 环境变量模板 —— 复制为 .env 并填入至少一家模型的 Key
# .env 是唯一密钥来源（已被 .gitignore 忽略，禁止提交进仓库）
# 三家只填一家即可完成问数与演示；全填可在前端切换模型
# bootstrap.sh 自检会校验：至少一个 Key 非空，否则拒绝继续（FR-01/FR-04）

# DeepSeek（默认模型）申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Qwen / 阿里云百炼 申请：https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=

# 智谱 GLM 申请：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=
